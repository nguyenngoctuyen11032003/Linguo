    "confidence: {name, sd, n, rapidShare, expected: \"low\"|\"medium\"|\"high\"} — confidenceFor(sd, n, rapidShare); rapidShare > 0.3 downgrades one step.",
    "suggest: {name, skills:[{level, confidence}], expected: int|null} — suggestLevel(skills).",
    "cap: {name, current, suggested, firstApplied, expected: int} — capLevel(current, suggested, firstApplied); firstApplied = no diagnostic applied to the path yet (max +2), else max +1; down always allowed.",
    "stop: {name, skill, n, sd, bankLeft, expected: bool} — shouldStopSkill(skill, n, sd, bankLeft)."
