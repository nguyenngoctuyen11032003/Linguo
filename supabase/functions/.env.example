# Local secrets for `supabase functions serve` (spec 5, AI tutor).
# Copy to supabase/functions/.env (git-ignored) and fill in. Never put these in VITE_* variables.
# Production: GitHub → Environment `production` → Secrets (pushed by the Deploy workflow), see docs/DEPLOY.md.

# Google AI Studio → Get API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# A free-tier Flash model id from AI Studio, e.g. a current "gemini-…-flash" model
GEMINI_MODEL=

# Optional (defaults shown)
# GEMINI_DAILY_USER_LIMIT=20
# GEMINI_MAX_OUTPUT_TOKENS=2048
# GEMINI_TIMEOUT_MS=20000

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# by `supabase functions serve` and by hosted Supabase; do not set them here.

# Reminders (spec 10 §3, notify-dispatch). Optional locally; see docs/DEPLOY.md → Nhắc học & Web Push.
# NOTIFY_CRON_SECRET=   # openssl rand -hex 32 (at least 32 characters, else every call gets 401)
# VAPID_PUBLIC_KEY=     # same value as VITE_VAPID_PUBLIC_KEY in the web .env
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:<you>@example.com
