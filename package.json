{
  "name": "linguo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @linguo/web dev",
    "build": "pnpm --filter @linguo/web build",
    "preview": "pnpm --filter @linguo/web preview",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/check-public-env.test.mjs scripts/sync-grading-fixtures.test.mjs && node --import tsx --test scripts/content-import.test.mjs",
    "e2e": "pnpm --filter @linguo/web e2e",
    "icons": "node scripts/make-icons.mjs",
    "check-env": "node scripts/check-public-env.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --fail-on error",
    "fixtures:sync": "node scripts/sync-estimate-fixtures.mjs",
    "content:check": "node --import tsx scripts/content-import.mjs --check",
    "content:build": "node --import tsx scripts/content-import.mjs --emit-sql",
    "content:push": "node --import tsx scripts/content-import.mjs --apply",
    "fixtures:grading": "node scripts/sync-grading-fixtures.mjs",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@linguo/shared": "workspace:*",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sharp": "0.35.5",
    "supabase": "2.120.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.9.1"
  }
}
